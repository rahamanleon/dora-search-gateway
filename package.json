{
  "name": "dora-search",
  "version": "1.0.0",
  "description": "Independent Web Search Infrastructure for Dora AI with SearXNG and multi-cloud failover",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "search",
    "searxng",
    "failover",
    "cloudflare-workers",
    "dora-ai",
    "web-search",
    "ssrf-protection",
    "crawler"
  ],
  "author": "Rl (https://github.com/rahamanleon)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahamanleon/dora-search-gateway.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
